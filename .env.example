# GoBiz / GoPay credentials
GOPAY_EMAIL=your-email@example.com
GOPAY_PASSWORD=your-password

# Backend listen address. The API + admin routes run here.
PORT=3000
HOST=0.0.0.0

# Persistent storage paths (optional; these are the local-development defaults).
# On a paid Render service with a disk mounted at /var/lib/gopay, set:
# DB_PATH=/var/lib/gopay/panel.db
# TOKEN_FILE_PATH=/var/lib/gopay/.gopay_token.enc
DB_PATH=data/panel.db
TOKEN_FILE_PATH=.gopay_token.enc

# --- Storage backend selection ---------------------------------------------
# STORAGE_BACKEND selects the DAL backend. Accepted values:
#   sqlite  (default) — better-sqlite3, single file at DB_PATH. The default and
#                       the simplest backend; no extra services required.
#   mongodb           — official MongoDB driver. Requires MONGODB_URI (below).
#                       Use a dedicated database name in the URI; Gopay must NOT
#                       share its database or database user with another app.
#
# MongoDB selection never falls back to SQLite on an error: if Atlas is
# unreachable at startup, the process fails fast rather than silently switching.
STORAGE_BACKEND=sqlite

# Required only when STORAGE_BACKEND=mongodb. The URI MUST include an explicit
# database name (e.g. ...host/gopay). Configure Atlas network access to allow
# only this service's outbound IP/CIDR. Never log this value.
# MONGODB_URI=mongodb+srv://gopay-user:strong-password@cluster.example/gopay

# Admin login for the panel. The backend seeds this user on first start
# (only if it does not already exist). Change the password to a strong one.
ADMIN_USERNAME=change-me-to-a-strong-username
ADMIN_PASSWORD=change-me-to-a-strong-password

# Master key for encrypting the GoBiz token at-rest (.gopay_token.enc, AES-256-GCM).
# If absent, the token is stored as plaintext (0600) with a warning.
MASTER_KEY=change-me-to-a-strong-random-secret

# HMAC-SHA256 key used to sign outgoing webhook payloads (X-Signature header).
WEBHOOK_HMAC_KEY=change-me-to-a-strong-random-secret

# HMAC secret used to sign admin panel session tokens (the admin_session cookie).
ADMIN_SESSION_SECRET=change-me-to-a-strong-random-secret

# Pino log level for the Fastify request/error logger (trace|debug|info|warn|error|fatal).
# Defaults to "info". Sensitive headers (Authorization, X-API-Key, Cookie) and
# fields (password, webhook_url) are always redacted.
LOG_LEVEL=info
