# Base URL of the backend REST_API / admin endpoints
API_BASE=http://localhost:3000

# Port/host the panel itself listens on. Kept different from the backend
# (which uses 3000) so the two processes do not collide.
PORT=3001
HOST=0.0.0.0

# Keep this NOT "production" while accessing over plain http:// — otherwise the
# admin session cookie is marked Secure (HTTPS-only) and login will not persist.
NODE_ENV=development

# Public origin users hit in the browser. adapter-node needs this for its CSRF
# check on POST form actions (login). Without it, adapter-node assumes https://
# and rejects plain-http POSTs with "Cross-site POST form submissions are
# forbidden" (403). Set it to the exact scheme://host:port you open in the
# browser. Behind an HTTPS reverse proxy, use the https:// domain instead.
ORIGIN=http://localhost:3001

# Server-held REST_API key the panel uses to call the API-key-protected payment
# endpoints (Create Payment / Live pages). Leave empty for now: log in first,
# create a key on the API Keys page, paste it here, then restart the panel.
PANEL_API_KEY=change-me-to-a-strong-random-secret
