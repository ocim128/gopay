{
  "name": "gopay-merchant-panel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted QRIS payment-gateway middleware on top of a GoPay Merchant (GoBiz) account: create dynamic QRIS, auto-detect settlement, and deliver signed webhooks (paid/expired).",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "start": "node build/index.js",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@lucide/svelte": "^1.23.0",
    "jsqr": "^1.4.0"
  }
}
